{
  "hosting": [
    {
      "target": "landing",
      "public": "landing_page/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/demo/**",
          "headers": [
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "Cross-Origin-Embedder-Policy",
              "value": "credentialless"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/demo/**",
          "destination": "/demo/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
